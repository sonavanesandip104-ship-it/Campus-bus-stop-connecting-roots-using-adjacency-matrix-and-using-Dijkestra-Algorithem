// Display all places
void displayPlaces() {
    cout << "\nAvailable Places:\n";

    for (int i = 0; i < N; i++) {
        cout << i << ". " << places[i] << endl;
    }
}

// Display all direct routes
void displayRoutes() {
    cout << "\nDirect Bus Routes:\n";

    for (int i = 0; i < N; i++) {
        for (int j = i + 1; j < N; j++) {
            if (graph[i][j] != INF) {
                cout << places[i] << " <--> "
                     << places[j] << " : "
                     << graph[i][j] << " km\n";
            }
        }
    }
}

// BFS to find reachable places
void BFS(int start) {
    bool visited[N] = {false};
    int queue[N];
    int front = 0, rear = 0;

    visited[start] = true;
    queue[rear++] = start;

    cout << "\nPlaces reachable from "
         << places[start] << ":\n";

    while (front < rear) {
        int current = queue[front++];

        cout << places[current] << endl;

        for (int i = 0; i < N; i++) {
            if (graph[current][i] != INF &&
                graph[current][i] != 0 &&
                !visited[i]) {

                visited[i] = true;
                queue[rear++] = i;
            }
        }
    }
}

